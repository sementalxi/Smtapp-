# ─── App ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="KIXO"
# Optional. Long random string for login sessions (derived from DATABASE_URL if empty).
AUTH_SECRET=""
# Optional, comma separated. These emails become ADMIN. (The first account ever is admin anyway.)
ADMIN_EMAILS=""

# ─── Database (PostgreSQL: Neon, Supabase, Railway…) ─
DATABASE_URL="postgresql://user:password@localhost:5432/bannerforge"

# ─── AI ──────────────────────────────────────────────
# "replicate" (default) or "openai" for the background image.
AI_PROVIDER="replicate"
REPLICATE_API_TOKEN=""
# Background image model (owner/name or owner/name:version)
REPLICATE_IMAGE_MODEL="black-forest-labs/flux-schnell"
# Background removal model for the player photo
REPLICATE_REMBG_MODEL="851-labs/background-remover"
# Pro AI mode (the AI designs the whole poster). Turns on when this key is set.
OPENAI_API_KEY=""
PRO_IMAGE_MODEL="gpt-image-2"
PRO_IMAGE_QUALITY="medium"      # low | medium | high  (high is slower and costs more)
# Only used when AI_PROVIDER="openai" for Quick-mode backgrounds
OPENAI_IMAGE_MODEL="gpt-image-1"

# ─── File storage ────────────────────────────────────
# On Vercel, connecting a Blob store (BLOB_READ_WRITE_TOKEN) is picked up automatically.
# "local" saves into ./uploads (development only — does NOT work on Vercel).
# "s3" works with AWS S3, Cloudflare R2, Backblaze B2, DigitalOcean Spaces…
STORAGE_DRIVER="local"
S3_ENDPOINT=""                 # e.g. https://<account>.r2.cloudflarestorage.com  (leave empty for AWS)
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""               # public base URL of the bucket, e.g. https://cdn.yoursite.com

# ─── Stripe ──────────────────────────────────────────
STRIPE_SECRET_KEY=""
# Optional — the admin panel's "Connect Stripe" button sets this up for you.
STRIPE_WEBHOOK_SECRET=""
# Optional overrides. Leave empty: prices are created in Stripe automatically.
STRIPE_PRICE_PACK_SMALL=""
STRIPE_PRICE_PACK_MEDIUM=""
STRIPE_PRICE_PACK_LARGE=""
STRIPE_PRICE_PLAN_STARTER=""
STRIPE_PRICE_PLAN_PRO=""
