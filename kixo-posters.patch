@@ -0,0 +1,59 @@
+import type { NextRequest } from "next/server";
+import { apiSession, unauthorized } from "@/lib/server/api-auth";
+import { requireOrganizationManager } from "@/lib/server/authorization";
+import { getOrganizationLeague } from "@/lib/server/bracket-api";
+import { leagueFeaturesEnabled } from "@/lib/server/config";
+import { noStoreHeaders, validateCsrf } from "@/lib/server/http";
+import { kixoConfigured, posterStatus, requestPoster, type PosterKind } from "@/lib/server/kixo-posters";
+import { organizationGuildIdForSession } from "@/lib/server/session-organization";
+import { enforceRateLimit, RateLimitError, rateLimitResponse } from "@/lib/server/rate-limit";
+
+export const maxDuration = 120;
+type Params = { params: Promise<{ leagueSlug: string; seasonId: string }> };
+
+async function context(request: NextRequest, params: Params["params"], limit: number) {
+  const current = await apiSession(request);
+  if (!current) return { error: unauthorized() };
+  const headers = await enforceRateLimit("mutation", current.sessionId, limit, 60);
+  const guildId = await organizationGuildIdForSession(current.session);
+  if (!guildId || !leagueFeaturesEnabled(guildId)) return { error: Response.json({ error: "league_not_available" }, { status: 404, headers: noStoreHeaders(headers) }) };
+  if (!await requireOrganizationManager(current.sessionId, current.session, guildId)) return { error: Response.json({ error: "organization_admin_required" }, { status: 403, headers: noStoreHeaders(headers) }) };
+  if (!kixoConfigured()) return { error: Response.json({ error: "posters_not_configured" }, { status: 503, headers: noStoreHeaders(headers) }) };
+  const { leagueSlug, seasonId } = await params;
+  return { current, headers, guildId, leagueSlug, seasonId: Number(seasonId) };
+}
+
+/** Make a poster: { kind: "standings" | "totw" | "potw", week } → { id } (KIXO's poster id). */
+export async function POST(request: NextRequest, { params }: Params) {
+  try {
+    const ctx = await context(request, params, 6);
+    if ("error" in ctx) return ctx.error;
+    validateCsrf(request, ctx.current.session);
+    const body = await request.json() as { kind?: string; week?: number };
+    const kind = (["standings", "totw", "potw"].includes(String(body.kind)) ? body.kind : "") as PosterKind;
+    if (!kind) return Response.json({ error: "invalid_kind" }, { status: 400, headers: noStoreHeaders(ctx.headers) });
+    const league = await getOrganizationLeague(ctx.guildId, ctx.leagueSlug, true);
+    const season = league.seasons.find((item) => item.id === ctx.seasonId);
+    if (!season) return Response.json({ error: "season_not_found" }, { status: 404, headers: noStoreHeaders(ctx.headers) });
+    const id = await requestPoster(league, season, kind, Math.max(1, Math.floor(Number(body.week) || 1)));
+    return Response.json({ id }, { headers: noStoreHeaders(ctx.headers) });
+  } catch (error) {
+    if (error instanceof RateLimitError) return rateLimitResponse(error);
+    const message = error instanceof Error ? error.message : "poster_failed";
+    return Response.json({ error: message }, { status: message === "csrf_validation_failed" ? 403 : 400, headers: noStoreHeaders() });
+  }
+}
+
+/** ?id=<KIXO poster id> → { status, url }. */
+export async function GET(request: NextRequest, { params }: Params) {
+  try {
+    const ctx = await context(request, params, 60);
+    if ("error" in ctx) return ctx.error;
+    const id = request.nextUrl.searchParams.get("id") ?? "";
+    if (!/^[A-Za-z0-9_-]{8,40}$/.test(id)) return Response.json({ error: "invalid_id" }, { status: 400, headers: noStoreHeaders(ctx.headers) });
+    return Response.json(await posterStatus(id), { headers: noStoreHeaders(ctx.headers) });
+  } catch (error) {
+    if (error instanceof RateLimitError) return rateLimitResponse(error);
+    return Response.json({ error: error instanceof Error ? error.message : "poster_status_failed" }, { status: 400, headers: noStoreHeaders() });
+  }
+}
