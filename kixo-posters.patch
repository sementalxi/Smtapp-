+"use client";
+
+import { useEffect, useRef, useState } from "react";
+import { Download, LoaderCircle, Sparkles } from "lucide-react";
+import { Button } from "@/components/ui/button";
+import { Card, CardContent } from "@/components/ui/card";
+import type { LeagueRecord, LeagueSeason } from "@/types";
+
+const KINDS = [
+  { id: "standings", label: "Standings", help: "The league table, with every team's logo." },
+  { id: "totw", label: "Team of the Week", help: "The best player in each place of a 4-3-3, from the week's match stats." },
+  { id: "potw", label: "Player of the Week", help: "The week's best player, from the match stats." },
+] as const;
+
+const ERRORS: Record<string, string> = {
+  posters_not_configured: "Posters are not set up yet (KIXO key missing).",
+  no_standings: "There is no table yet for this season.",
+  not_enough_player_stats: "No player stats for this week yet.",
+  kixo_err_credits: "The KIXO account has no credits left.",
+  kixo_rate_limited: "Too many posters right now — try again later.",
+};
+
+/** League posters made by KIXO's AI from this season's data (1–2 minutes each). */
+export function LeaguePosters({ league, season, csrf }: { league: LeagueRecord; season: LeagueSeason; csrf: string }) {
+  const weeks = [...new Set(season.fixtures.filter((f) => (f.actual_participants ?? []).some((p) => p.members?.length)).map((f) => f.week_number))].sort((a, b) => a - b);
+  const [week, setWeek] = useState(weeks[weeks.length - 1] ?? 1);
+  const [busy, setBusy] = useState("");
+  const [error, setError] = useState("");
+  const [result, setResult] = useState<{ kind: string; url: string } | null>(null);
+  const timer = useRef<number | null>(null);
+  useEffect(() => () => { if (timer.current) window.clearTimeout(timer.current); }, []);
+  const base = `/api/organization/leagues/${encodeURIComponent(league.slug)}/seasons/${season.id}/posters`;
+
+  async function make(kind: string) {
+    if (busy) return;
+    setBusy(kind); setError(""); setResult(null);
+    try {
+      const response = await fetch(base, { method: "POST", headers: { "Content-Type": "application/json", "X-CSRF-Token": csrf }, body: JSON.stringify({ kind, week }) });
+      const data = await response.json();
+      if (!response.ok || !data.id) throw new Error(data.error ?? "poster_failed");
+      const started = Date.now();
+      const poll = async () => {
+        try {
+          const r = await fetch(`${base}?id=${encodeURIComponent(data.id)}`, { cache: "no-store" });
+          const s = await r.json();
+          if (s.status === "ready") { setResult({ kind, url: s.url }); setBusy(""); return; }
+          if (s.status === "failed" || Date.now() - started > 6 * 60_000) { setError(ERRORS[`kixo_${s.error}`] ?? "The poster could not be made. Try again."); setBusy(""); return; }
+        } catch { /* keep waiting */ }
+        timer.current = window.setTimeout(poll, 5000);
+      };
+      timer.current = window.setTimeout(poll, 8000);
+    } catch (e) {
+      const code = e instanceof Error ? e.message : "";
+      setError(ERRORS[code] ?? "The poster could not be made. Try again.");
+      setBusy("");
+    }
+  }
+
+  return <Card><CardContent className="space-y-4 p-5">
+    <div className="flex items-center gap-2"><Sparkles className="size-4" /><h3 className="font-semibold">League posters</h3></div>
+    <p className="text-sm text-muted-foreground">Made by KIXO&apos;s AI from this season&apos;s table and match stats. Each poster takes 1–2 minutes.</p>
+    {weeks.length > 0 && <label className="flex items-center gap-2 text-sm">Week
+      <select className="rounded-lg border border-white/10 bg-background px-2 py-1" value={week} onChange={(e) => setWeek(Number(e.target.value))}>{weeks.map((w) => <option key={w} value={w}>{w}</option>)}</select>
+    </label>}
+    <div className="grid gap-2 sm:grid-cols-3">{KINDS.map((k) => <Button key={k.id} type="button" variant="outline" disabled={!!busy || (k.id !== "standings" && !weeks.length)} onClick={() => void make(k.id)} title={k.help} className="h-auto flex-col items-start gap-1 p-3 text-left">
+      <span className="flex items-center gap-2 font-medium">{busy === k.id && <LoaderCircle className="size-4 animate-spin" />}{k.label}</span>
+      <span className="text-xs font-normal text-muted-foreground whitespace-normal">{k.help}</span>
+    </Button>)}</div>
+    {busy && <p className="text-sm text-muted-foreground">Making the poster… you can stay on this page.</p>}
+    {error && <p className="text-sm text-rose-300">{error}</p>}
+    {result && <div className="space-y-2">
+      {/* eslint-disable-next-line @next/next/no-img-element */}
+      <img src={result.url} alt="League poster" className="w-full max-w-md rounded-xl border border-white/10" />
+      <a href={result.url} target="_blank" rel="noreferrer" className="inline-flex items-center gap-2 text-sm underline"><Download className="size-4" />Open / download</a>
+    </div>}
+  </CardContent></Card>;
+}
