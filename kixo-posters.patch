@@ -0,0 +1,132 @@
+import "server-only";
+import type { LeagueRecord, LeagueSeason } from "@/types";
+import { canonicalUrl } from "./config";
+
+// League posters made by KIXO (kixo.pro): Leaguely sends the season's data, KIXO's AI makes the poster.
+// Needs KIXO_PARTNER_KEY (the same value is set on KIXO). KIXO_URL defaults to https://kixo.pro.
+export type PosterKind = "standings" | "totw" | "potw";
+const STYLE: Record<PosterKind, string> = { standings: "standings-red-leaders", totw: "totw-red-shields", potw: "player-of-the-week" };
+
+export function kixoConfigured() {
+  return String(process.env.KIXO_PARTNER_KEY ?? "").trim().length >= 24;
+}
+
+const kixoBase = () => String(process.env.KIXO_URL || "https://kixo.pro").replace(/\/$/, "");
+
+async function kixo(path: string, init: { method?: string; body?: unknown } = {}) {
+  const base = kixoBase();
+  const response = await fetch(`${base}${path}`, {
+    method: init.method ?? "GET",
+    headers: { "x-kixo-key": String(process.env.KIXO_PARTNER_KEY ?? "").trim(), ...(init.body ? { "Content-Type": "application/json" } : {}) },
+    body: init.body ? JSON.stringify(init.body) : undefined,
+    cache: "no-store",
+    signal: AbortSignal.timeout(60_000),
+  });
+  const data = await response.json().catch(() => ({})) as Record<string, unknown>;
+  if (!response.ok) throw new Error(`kixo_${String(data.error ?? response.status)}`);
+  return data;
+}
+
+/** Copies a Leaguely logo into KIXO's storage (KIXO only takes its own files). "" when it fails. */
+async function importLogo(url?: string | null) {
+  if (!url) return "";
+  const absolute = url.startsWith("http") ? url : `${canonicalUrl()}${url.startsWith("/") ? "" : "/"}${url}`;
+  try {
+    const data = await kixo("/api/upload/from-url", { method: "POST", body: { url: absolute, kind: "logo" } });
+    return typeof data.url === "string" ? data.url : "";
+  } catch {
+    return "";
+  }
+}
+
+type Member = { name: string; position: string; rating: number; goals: number; assists: number; entryId: number };
+
+function weekMembers(season: LeagueSeason, week: number): Member[] {
+  const out: Member[] = [];
+  for (const fixture of season.fixtures.filter((item) => item.week_number === week)) {
+    for (const side of fixture.actual_participants ?? []) {
+      for (const member of side.members ?? []) {
+        if (!member.name?.trim()) continue;
+        out.push({ name: member.name.trim(), position: String(member.position ?? "").toUpperCase(), rating: Number.parseFloat(String(member.rating ?? "0")) || 0, goals: member.goals ?? 0, assists: member.assists ?? 0, entryId: side.team_entry_id });
+      }
+    }
+  }
+  return out;
+}
+
+const score = (m: Member) => m.rating * 10 + m.goals * 3 + m.assists * 2;
+const GROUPS: Array<{ slots: string[]; match: RegExp }> = [
+  { slots: ["GK"], match: /^(GK|POR)$/ },
+  { slots: ["RB", "CB", "CB", "LB"], match: /^(CB|LB|RB|LWB|RWB|DFC|LI|LD|CAD|CAI|DEF)$/ },
+  { slots: ["CM", "CM", "CM"], match: /^(CM|CDM|CAM|LM|RM|MC|MCD|MCO|MI|MD|MID)$/ },
+  { slots: ["RW", "ST", "LW"], match: /^(ST|CF|LW|RW|DC|SD|EI|ED|FW)$/ },
+];
+
+/** The best player in each place of a 4-3-3 for that week (by match rating, goals and assists). */
+export function teamOfTheWeek(season: LeagueSeason, week: number) {
+  const pool = weekMembers(season, week).sort((a, b) => score(b) - score(a));
+  const used = new Set<Member>();
+  const picks: Array<{ member: Member; slot: string }> = [];
+  for (const group of GROUPS) {
+    for (const slot of group.slots) {
+      const member = pool.find((m) => !used.has(m) && group.match.test(m.position)) ?? pool.find((m) => !used.has(m));
+      if (!member) continue;
+      used.add(member);
+      picks.push({ member, slot });
+    }
+  }
+  return picks;
+}
+
+export function weeksWithStats(season: LeagueSeason) {
+  return [...new Set(season.fixtures.filter((f) => (f.actual_participants ?? []).some((p) => p.members?.length)).map((f) => f.week_number))].sort((a, b) => a - b);
+}
+
+/** Asks KIXO for a poster; returns KIXO's poster id (the poster is ready 1–2 minutes later). */
+export async function requestPoster(league: LeagueRecord, season: LeagueSeason, kind: PosterKind, week: number) {
+  const entry = (id: number) => season.entries.find((item) => item.id === id);
+  const leagueName = league.name.slice(0, 60);
+  const inputs: Record<string, unknown> = { competition: leagueName, footer: "LEAGUELY.PRO" };
+  let photoUrl: string | null = null;
+  let logoUrl: string | null = null;
+  if (kind === "standings") {
+    const scope = season.standings[0]?.scope_type;
+    const rows = season.standings.filter((row) => row.scope_type === scope).sort((a, b) => a.rank - b.rank).slice(0, 20);
+    if (!rows.length) throw new Error("no_standings");
+    inputs.headline = "STANDINGS";
+    inputs.date = `${season.name}`.slice(0, 40);
+    inputs.standings = rows.map((row) => `${row.rank}. ${(entry(row.team_entry_id)?.display_name ?? "TEAM").slice(0, 40)} · P ${row.played} · W ${row.wins} · D ${row.draws} · L ${row.losses} · GD ${row.score_diff > 0 ? "+" : ""}${row.score_diff} · PTS ${row.points}`);
+    inputs.tableLogos = await Promise.all(rows.map((row) => importLogo(entry(row.team_entry_id)?.logo_url)));
+  } else if (kind === "totw") {
+    const picks = teamOfTheWeek(season, week);
+    if (picks.length < 5) throw new Error("not_enough_player_stats");
+    inputs.headline = "TEAM OF THE WEEK";
+    inputs.date = `WEEK ${week} · ${season.name}`.slice(0, 40);
+    inputs.formation = "4-3-3";
+    inputs.players = picks.map(({ member, slot }) => `${member.name.slice(0, 18)} · ${(entry(member.entryId)?.display_name ?? "").slice(0, 14)} · ${slot}`.slice(0, 40));
+    inputs.playerLogos = await Promise.all(picks.map(({ member }) => importLogo(entry(member.entryId)?.logo_url)));
+  } else {
+    const best = weekMembers(season, week).sort((a, b) => score(b) - score(a))[0];
+    if (!best) throw new Error("not_enough_player_stats");
+    const team = entry(best.entryId);
+    inputs.name = best.name.slice(0, 30);
+    inputs.team = (team?.display_name ?? "").slice(0, 40);
+    inputs.position = best.position.slice(0, 6);
+    inputs.number = best.rating ? best.rating.toFixed(1) : String(best.goals);
+    inputs.tagline = "PLAYER OF THE WEEK";
+    inputs.subtitle = `WEEK ${week} · ${season.name}`.slice(0, 60);
+    logoUrl = (await importLogo(team?.logo_url)) || null;
+  }
+  const data = await kixo("/api/banners", { method: "POST", body: { templateSlug: STYLE[kind], mode: "PRO", inputs, photoUrl, logoUrl } });
+  if (typeof data.id !== "string") throw new Error("kixo_no_id");
+  return data.id;
+}
+
+/** The poster's state at KIXO: { status: "pending" | "ready" | "failed", url? }. */
+export async function posterStatus(id: string) {
+  const data = await kixo(`/api/banners/${encodeURIComponent(id)}`);
+  const raw = typeof data.finalUrl === "string" ? data.finalUrl : "";
+  const url = raw.startsWith("/") ? `${kixoBase()}${raw}` : raw;
+  const status = String(data.status ?? "");
+  return { status: url && status === "READY" ? "ready" : status === "FAILED" || data.error ? "failed" : "pending", url, error: data.error ? String(data.error) : "" };
+}
