generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  STAFF
  SUPPORT
}

enum TxType {
  SIGNUP_BONUS
  PURCHASE
  SUBSCRIPTION
  GENERATION
  REFUND
  ADMIN_ADJUST
  REFERRAL
  DAILY
}

enum BannerStatus {
  PROCESSING
  READY
  FAILED
}

enum Layout {
  PLAYER
  CHAMPIONS
  EVENT
  MATCHDAY
  LINEUP
  RESULT
  STANDINGS
  LOGO
  TOTW
  QUALIFIERS
  WINNERS
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  name               String
  passwordHash       String
  role               Role                @default(USER)
  // "discord" when the ADMIN role came from the Discord admin role (removed again when the role goes); null = set by hand
  adminVia           String?
  credits            Int                 @default(0)
  banned             Boolean             @default(false)
  locale             String              @default("es")
  stripeCustomerId   String?             @unique
  subscriptionId     String?             @unique
  subscriptionStatus String?
  planId             String?
  currentPeriodEnd   DateTime?
  refCode            String? // personal invite code (checked unique in code)
  referredById       String? // who invited this user
  discordId          String? // linked Discord account (checked unique in code)
  discordName        String? // Discord username shown on the profile
  discordUser        String? // Discord @handle
  discordAvatar      String? // Discord profile picture URL
  emailOptOut        Boolean             @default(false) // unsubscribed from promo emails
  showcaseOptOut     Boolean             @default(false) // don't post my posters in the public Discord showcase
  isOrg              Boolean             @default(false) // organization account (admin sets) — sees "orgs" styles
  phone              String? // verified phone (E.164) — one account per number, checked in code
  dailyStreak        Int                 @default(0) // consecutive days the daily reward was claimed
  dailyClaimedDay    String? // last claimed day (YYYY-MM-DD in the site's time zone)
  dailyClaimedAt     DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  transactions       CreditTransaction[] @relation("UserTx")
  adminActions       CreditTransaction[] @relation("AdminTx")
  banners            Banner[]
  payments           Payment[]

  @@index([refCode])
  @@index([phone])
  @@index([discordId])
  @@index([referredById])
}

model CreditTransaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("UserTx", fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  balance   Int
  type      TxType
  note      String?
  adminId   String?
  admin     User?    @relation("AdminTx", fields: [adminId], references: [id], onDelete: SetNull)
  bannerId  String?
  // Stripe event/session id — unique so a webhook can never grant credits twice.
  externalRef String? @unique
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Template {
  id         String   @id @default(cuid())
  slug       String   @unique
  name       String
  nameEs     String
  layout     Layout   @default(PLAYER)
  // Prompt sent to the image model for the background
  prompt     String
  // Design tokens used by the canvas renderer (colors, fonts, effects)
  style      Json
  cost       Int      @default(1)
  // Optional example design (owned by you) the Pro AI should match in look and feel
  styleRefUrl String?
  // Sample image shown in style pickers (replaces the drawn preview)
  thumbUrl   String?
  // Admin's own instructions for the Pro AI for this style (take priority over the defaults)
  proInstructions String?
  // Random palette/concept/layout per poster (off = consistent look every time)
  randomize  Boolean  @default(true)
  // Admin settings for this style's text boxes (flyer lines): JSON list of {key, on, label, labelEs, ph, where, custom} — see lib/text-slots
  textSlots  String?
  // Labels shown on the style in the Create page, comma-separated: "recommended,fire,photoshop,new"
  badge      String?
  // Quality tier tag shown in the card's bottom-right corner: "basic" | "mid" | "pro" | null
  tier       String?
  // Who can see/use this style: "all" | "users" (regular accounts only) | "orgs" (organizations only)
  audience   String   @default("all")
  active     Boolean  @default(true)
  deletedAt  DateTime? // deleted by the admin (kept so old posters still know their style)
  sort       Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  banners    Banner[]
}

model Banner {
  id            String       @id @default(cuid())
  // The exact brief sent to the AI (admins can view it on the poster page)
  prompt        String?
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId    String
  template      Template     @relation(fields: [templateId], references: [id])
  status        BannerStatus @default(PROCESSING)
  // "QUICK" = template + AI background, "PRO" = AI designs the whole poster
  mode          String       @default("QUICK")
  title         String
  // What the user typed: name, team, position, roster…
  inputs        Json
  // Editor state (offsets, scales, text overrides)
  design        Json?
  photoUrl      String?
  cutoutUrl     String?
  logoUrl       String?
  backgroundUrl String?
  finalUrl      String?
  error         String?
  stage         String? // live progress while generating: art | realism | text | openai | finishing
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([userId, createdAt])
}

model Payment {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeRef       String   @unique
  kind            String // "pack" | "subscription"
  productId       String
  amountCents     Int
  currency        String
  credits         Int
  createdAt       DateTime @default(now())

  @@index([createdAt])
}

model Setting {
  key   String @id
  value String
}

// Images stored in the database when no Blob/S3 storage is available.
model StoredFile {
  id          String   @id @default(cuid())
  contentType String
  data        Bytes
  createdAt   DateTime @default(now())
}

// Teams and championships a user saves once and reuses (name + logo).
model SavedItem {
  id        String   @id @default(cuid())
  userId    String
  kind      String // "team" | "championship"
  name      String
  logoUrl   String?
  players   String? // team roster as JSON: [{ num, name, pos }]
  createdAt DateTime @default(now())

  @@index([userId, kind])
}

// A Square checkout link we created, so the webhook knows who paid for what.
model SquareCheckout {
  orderId   String   @id
  userId    String
  kind      String // "pack" | "plan"
  productId String
  credits   Int
  createdAt DateTime @default(now())

  @@index([userId])
}

// Official logos the admin adds (leagues / competitions / teams) — everyone can pick them.
model LibraryItem {
  id        String   @id @default(cuid())
  kind      String // "championship" | "team"
  name      String
  logoUrl   String?
  sort      Int      @default(0)
  createdAt DateTime @default(now())

  @@index([kind, sort])
}

// Limited-time offers shown on the home page ("Don't miss these deals"), managed in Admin → Deals.
model Deal {
  id        String    @id @default(cuid())
  title     String
  subtitle  String    @default("")
  price     String    @default("")
  priceUsd  Float? // real checkout price — when set with credits, the button buys the deal
  credits   Int       @default(0)
  tags      String    @default("") // comma-separated chips, e.g. "Limited time, Best value"
  included  String    @default("") // one item per line
  imageUrl  String?
  ctaLabel  String    @default("")
  ctaHref   String    @default("/pricing")
  endsAt    DateTime?
  active    Boolean   @default(true)
  sort      Int       @default(0)
  createdAt DateTime  @default(now())
}

// Live support chat: each ticket is a private Discord channel; staff reply there, the user chats on the website.
model SupportTicket {
  id         String   @id @default(cuid())
  userId     String
  channelId  String
  webhookUrl String
  status     String   @default("open") // open | closed
  lastStaffId String?  // newest staff reply the user has seen or been notified about
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, status])
}

// Browser push subscriptions (support replies reach the phone even when the site is closed).
model PushSub {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// AI videos (image → video with Kling via fal.ai). Charged in credits; refunded if it fails.
model VideoJob {
  id          String   @id @default(cuid())
  userId      String
  bannerId    String?
  model       String
  prompt      String
  seconds     Int
  audio       Boolean  @default(true)
  cost        Int
  status      String   @default("queued") // queued | running | done | failed
  statusUrl   String?
  responseUrl String?
  videoUrl    String?
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status])
}

// Live activity log for Admin → Live log (website + Discord bot). Old rows are pruned after 7 days.
model ActivityLog {
  id        String   @id @default(cuid())
  source    String   // site | bot
  level     String   @default("info") // info | warn | error
  kind      String
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Custom order payment links: the admin makes one (title + price), sends kixo.pro/pay/<id>, the customer pays.
model PayLink {
  id          String    @id
  title       String
  description String    @default("")
  amountCents Int
  customer    String    @default("") // who it's for (name / Discord) — shown on the page
  note        String    @default("") // private note for the admin
  status      String    @default("open") // "open" | "paid" | "canceled"
  provider    String    @default("")
  providerRef String    @default("") // last checkout (Square order id / Stripe session id)
  paidRef     String    @default("")
  paidAt      DateTime?
  createdById String    @default("")
  createdAt   DateTime  @default(now())

  @@index([createdAt])
}

/// Logo maker: one request → 5 logo options. Players see watermarked previews; only the one they pick is unlocked.
model LogoSet {
  id        String   @id @default(cuid())
  userId    String
  inputs    Json
  status    String   @default("PROCESSING") // PROCESSING | READY | FAILED
  /// [{ preview, full } | null] — full-size URLs never leave the server until picked
  options   Json     @default("[]")
  picked    Int      @default(-1)
  pickedUrl String   @default("")
  pngUrl    String   @default("")
  bannerId  String   @default("")
  cost      Int      @default(0)
  error     String   @default("")
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// Streamer kit: a matching set of TikTok LIVE pieces (promo, starting soon, BRB, ending, cam overlay…).
model StreamKit {
  id        String   @id @default(cuid())
  userId    String
  inputs    Json
  /// [{ kind, status: "queued" | "making" | "ready" | "failed", url, error }]
  items     Json     @default("[]")
  status    String   @default("PROCESSING") // PROCESSING | DONE
  cost      Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
