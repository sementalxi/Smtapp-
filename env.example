# REQUIRED
DISCORD_TOKEN=
GUILD_ID=

# BOT IDENTITY
BOT_NAME=KIXO | GFX STUDIO
BRAND_NAME=KIXO | GFX STUDIO
BRAND_COLOR=#FF2D8B
BRAND_LOGO_URL=

# CHANNELS / KNOWLEDGE
ANSWER_CHANNEL_ID=
SEARCH_CHANNEL_IDS=
IGNORED_CHANNEL_IDS=
IGNORED_CATEGORY_IDS=
LOG_CHANNEL_ID=
WELCOME_CHANNEL_ID=
WELCOME_ROLE_ID=

# VERIFICATION
UNVERIFIED_ROLE_ID=
VERIFIED_ROLE_ID=
VERIFY_ASSIGN_JOIN_ROLE=true
VERIFY_PANEL_TITLE=
VERIFY_PANEL_TEXT=This server requires you to verify yourself to get access to the other channels. Click the Verify button below to continue.
VERIFY_BUTTON_TEXT=Verify
VERIFY_PANEL_COLOR=#5865F2

# TICKETS
# Optional legacy/default destination. Each button can be routed from /ticket-admin.
TICKET_CATEGORY_ID=
TICKET_TRANSCRIPT_CHANNEL_ID=
TICKET_CLOSED_CATEGORY_ID=
TICKET_PANEL_FOOTER=KIXO | GFX STUDIO • Orders
TICKET_PANEL_COLOR=#FF2D8B
TICKET_LOGO_URL=
TICKET_BANNER_URL=
TICKET_PANEL_TITLE=🎨 KIXO | GFX STUDIO • Orders
TICKET_PANEL_TEXT=Choose a service to open a private ticket. / Elige una opción para abrir un ticket.
STAFF_ROLE_IDS=

# SMART ANSWERS
ANSWER_MODE=hybrid
AUTO_DISCOVER_CHANNELS=true
SMART_CHANNEL_FILTER=true
SMART_IGNORE_PATTERNS=
MAX_MESSAGES_PER_CHANNEL=500
MAX_RESULTS=8
MIN_SCORE=2.0
AUTO_SYNC_MINUTES=30

# OPTIONAL OPENAI ANSWERS
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
AI_MAX_OUTPUT_TOKENS=700
AI_INCLUDE_UNPUBLISHED_RULES=false

# MODERATION
AUTO_MOD_ENABLED=false
BLOCK_INVITES=false
AUTO_MOD_WORDS=

# CROSS-CHANNEL SPAM GUARD
# Detects the same/highly-similar message sent across multiple channels.
SPAM_GUARD_ENABLED=true
SPAM_GUARD_MIN_CHANNELS=3
SPAM_GUARD_WINDOW_SECONDS=20
# ban | timeout | delete
SPAM_GUARD_ACTION=ban
SPAM_GUARD_TIMEOUT_MINUTES=1440
SPAM_GUARD_MIN_LENGTH=12
SPAM_GUARD_IGNORED_CHANNEL_IDS=
SPAM_GUARD_IGNORED_ROLE_IDS=

# RAILWAY HEALTH CHECK
PORT=3000

# PERSISTENCE
# Railway: mount one volume at /data and set both values to /data.
DATA_DIR=./data
RULES_DATA_DIR=./data

# Custom ticket staff command prefix
TICKET_COMMAND_PREFIX=!

# WEB TICKET CONTROL CENTER
# Open https://YOUR-RAILWAY-DOMAIN/admin after deployment.
DASHBOARD_PASSWORD=
# Optional. If blank, the dashboard password is also used to sign sessions.
DASHBOARD_SESSION_SECRET=

# Web Control Center V8.3
BOT_CONTROL_SECRET=use-a-long-random-secret
# Optional moderation log channel. Can also be changed from the website.
LOG_CHANNEL_ID=
VERIFY_REPAIR_HOURS=24

# Recommended KIXO safety defaults
AUTO_DISCOVER_CHANNELS=false
SPAM_GUARD_ENABLED=false
SPAM_GUARD_ACTION=delete
VERIFY_DEADLINE_ENABLED=false
# Use a separate KIXO token / guild ID, not the originals.
